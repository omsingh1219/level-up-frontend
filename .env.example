# ==============================================================================
# GymOS Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT CONFIGURATION (Vite Client-Safe Firebase Config)
# ------------------------------------------------------------------------------
# Get these values from your Firebase Project Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="gymos-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gymos-prod"
VITE_FIREBASE_STORAGE_BUCKET="gymos-prod.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Set to "true" to connect to local Firebase Emulators instead of live Cloud
VITE_USE_FIREBASE_EMULATORS="false"
VITE_EMULATOR_HOST="127.0.0.1"

# Application URL
VITE_APP_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS & BACKEND FUNCTIONS (Never expose to browser client!)
# ------------------------------------------------------------------------------
# Used by Firebase Admin SDK in Cloud Functions:
FIREBASE_ADMIN_PROJECT_ID="gymos-prod"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@gymos-prod.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v18.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="gymos_secure_verify_token_change_in_prod"
WHATSAPP_APP_SECRET=""

# Transactional Email Provider (Resend / SendGrid / SMTP)
EMAIL_PROVIDER="NONE"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="GymOS Notifications <notifications@gymos.app>"
EMAIL_REPLY_TO="support@gymos.app"
